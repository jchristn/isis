# Isis Docker environment — copy to `.env` and edit before `docker compose up`.
# docker compose automatically reads `.env` in this directory and substitutes ${VAR} in compose.yaml.
#
# These are LOCAL DEVELOPMENT DEFAULTS. Change every value below before any shared or hosted deployment.

# --- Isis authentication -----------------------------------------------------
# The default administrator user seeded on first boot. Log into the dashboard with these credentials
# (email + password). This user has IsAdmin set and is the bootstrap login for a fresh deployment.
# Maps to ISIS_AUTH_SEED_ADMIN_EMAIL -> Auth.SeedAdminEmail and ISIS_AUTH_SEED_ADMIN_PASSWORD -> Auth.SeedAdminPassword.
ISIS_AUTH_SEED_ADMIN_EMAIL=admin@isis.local
ISIS_AUTH_SEED_ADMIN_PASSWORD=isisadmin

# Access key + secret key seeded on the default tenant credential, presented in the x-access-key and
# x-secret-key headers (used by the MCP server and automation).
# Maps to ISIS_AUTH_DEFAULT_ACCESS_KEY -> Auth.DefaultAccessKey and ISIS_AUTH_DEFAULT_SECRET_KEY -> Auth.DefaultSecretKey.
ISIS_AUTH_DEFAULT_ACCESS_KEY=isisdefaultkey
ISIS_AUTH_DEFAULT_SECRET_KEY=isisdefaultsecret

# --- RecallDB ----------------------------------------------------------------
# Admin API key RecallDB accepts and that Isis presents when calling RecallDB server-side.
# This must match AdminApiKeys in docker/recalldb/recalldb.json AND RecallDb.AdminApiKey in
# docker/isis/isis.json (there is no env override for the Isis-side value in 0.1.0 — edit the file).
RECALLDB_ADMIN_KEY=recalldbadmin

# --- Grafana -----------------------------------------------------------------
# Grafana admin password (user is `admin`). Override out of band for anything non-local.
GF_SECURITY_ADMIN_PASSWORD=admin

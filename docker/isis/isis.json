{
  "nodeId": "isis-1",
  "rest": {
    "hostname": "*",
    "port": 8700,
    "ssl": false
  },
  "database": {
    "type": "Postgresql",
    "filename": "data/isis.db",
    "hostname": "postgres",
    "port": 5432,
    "databaseName": "isis",
    "username": "isis",
    "password": "isis",
    "schema": "public",
    "logQueries": false,
    "requireEncryption": false
  },
  "recallDb": {
    "endpoint": "http://recalldb-server:8600",
    "adminApiKey": "recalldbadmin"
  },
  "verbex": {},
  "auth": {
    "issuer": "isis",
    "sessionLifetimeMinutes": 1440,
    "seedAdminEmail": "admin@isis.local",
    "seedAdminPassword": "isisadmin",
    "defaultAccessKey": "isisdefaultkey",
    "defaultSecretKey": "isisdefaultsecret"
  },
  "logging": {
    "consoleLogging": true,
    "logQueries": false
  },
  "requestHistory": {
    "enabled": true,
    "captureHeaders": true,
    "captureBodies": true,
    "maxBodyBytes": 16384
  },
  "observability": {
    "enabled": true,
    "serviceName": "isis-server",
    "prometheusEnabled": true,
    "prometheusHostname": "*",
    "prometheusPort": 9464,
    "prometheusPath": "/metrics",
    "tracingEnabled": true,
    "otlpEndpoint": "http://tempo:4317",
    "otlpProtocol": "grpc",
    "samplingRatio": 1,
    "includeRuntimeMetrics": true,
    "includeProcessMetrics": true
  }
}